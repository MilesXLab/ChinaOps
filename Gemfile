source "https://rubygems.org"

# GitHub Pages managed Jekyll environment
# Pin to github-pages gem so the build matches what GH Pages uses.
# See https://pages.github.com/versions/ for current versions.
gem "github-pages", group: :jekyll_plugins

# jekyll-seo-tag and jekyll-sitemap are included in github-pages;
# listed here for local install clarity.
group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end
